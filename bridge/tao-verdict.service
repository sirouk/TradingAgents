[Unit]
Description=TradingAgents external-verdict bridge (bare-metal reference unit)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Template: point these at YOUR checkout + target workspace before enabling.
# One run at a time, hard cap: never let a hang eat the next slot.
ExecStart=/usr/bin/flock -n /run/tao-verdict.lock /opt/tradingagents/.venv/bin/python /opt/tradingagents/bridge/tao_verdict.py --target-dir %h/tao-fleet
TimeoutStartSec=65min
WorkingDirectory=/opt/tradingagents
User=bridge
StandardOutput=append:/var/log/tao-verdict.log
StandardError=append:/var/log/tao-verdict.log
